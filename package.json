{
  "name": "atombook",
  "version": "1.0.0",
  "private": true,
  "description": "Atombook: offline GST invoicing and billing for Windows, Linux and Android",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test": "tsx tests/run.ts",
    "typecheck": "tsc --noEmit",
    "electron": "npm run build && electron .",
    "electron:win": "npm run build && electron-builder --win",
    "electron:linux": "npm run build && electron-builder --linux",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "copy-assets": "node scripts/copy-assets.js",
    "predev": "npm run copy-assets",
    "prebuild": "node scripts/copy-assets.js",
    "android:add": "cap add android",
    "electron:win:dir": "npm run build && electron-builder --win dir",
    "electron:linux:dir": "npm run build && electron-builder --linux dir"
  },
  "build": {
    "appId": "in.atomprod.atombook",
    "productName": "Atombook",
    "files": [
      "out/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico",
      "artifactName": "Atombook-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "npmRebuild": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "Atombook",
      "artifactName": "Atombook-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png"
    },
    "appImage": {
      "artifactName": "Atombook-${version}.${ext}"
    },
    "deb": {
      "artifactName": "Atombook-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@capacitor/browser": "^8.0.5",
    "@fontsource/noto-sans": "^5.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.65.0",
    "next": "^15.5.28",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  },
  "author": {
    "name": "Mohammad Kaif",
    "email": "kaif@atomprod.in"
  },
  "homepage": "https://localhost"
}
