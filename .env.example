# Google OAuth "Web application" client id, used for Google Drive sync in the online version.
# See ONLINE-SETUP.md. Build-time value: set it in your hosting dashboard (Netlify / Vercel /
# Cloudflare Pages) and redeploy. It is a public identifier, not a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Windows/Linux app (OAuth client type "Desktop app")
NEXT_PUBLIC_GOOGLE_DESKTOP_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_DESKTOP_CLIENT_SECRET=
# Android app (OAuth client type "Android", package in.atomprod.atombook)
NEXT_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
